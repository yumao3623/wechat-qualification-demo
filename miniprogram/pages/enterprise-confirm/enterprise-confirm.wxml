<view class="page">
  <view class="step">STEP 1 / 3 · 确认主体</view>
  <view class="page-title">请确认企业主体</view>
  <view class="muted">确认后才会为该企业建立本机游客草稿上下文。</view>
  <async-state state="{{state}}" message="{{state === 'loading' ? '正在获取企业详情' : errorMessage}}" detail="{{requestId}}" bindretry="loadEnterprise">
    <view wx:if="{{state === 'success'}}" class="detail card">
      <view class="row title-row"><view class="company-name">{{enterprise.name}}</view><demo-badge /></view>
      <view class="detail-row"><text>主体编号</text><text>{{enterprise.subjectCode}}</text></view>
      <view class="detail-row"><text>法定代表人</text><text>{{enterprise.legalRepresentative}}</text></view>
      <view class="detail-row"><text>成立日期</text><text>{{enterprise.establishedAt}}</text></view>
      <view class="detail-row"><text>注册资本</text><text>{{enterprise.capitalText}}</text></view>
      <view class="detail-row"><text>所在地区</text><text>{{enterprise.regionText}}</text></view>
      <view class="detail-row"><text>企业状态</text><text>{{enterprise.statusText}}</text></view>
      <view class="detail-row"><text>所属行业</text><text>{{enterprise.industry.name}}</text></view>
      <view class="notice demo-notice">以上为招聘 Demo 使用的完全虚构主体，不映射真实企业。</view>
      <view class="button-stack actions">
        <button class="primary-button" bindtap="confirmEnterprise">确认是该企业</button>
        <button class="secondary-button" bindtap="chooseAgain">返回重新选择</button>
      </view>
    </view>
  </async-state>
</view>
