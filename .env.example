# 当前完整 Demo 可直接使用 Mock Provider 与 Demo Auth，无需任何真实密钥。
NODE_ENV=development
PORT=3000
ENTERPRISE_PROVIDER=mock
AUTH_MODE=demo
SESSION_TTL_MS=43200000
ASSESSMENT_PENDING_MS=300
ASSESSMENT_STAGE_MS=200
# RUNTIME_DATA_PATH=server/data/runtime

# 未来正式接入时仅在本地 .env / 密钥托管中配置，不得提交真实值。
QICHACHA_API_KEY=
QICHACHA_API_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
