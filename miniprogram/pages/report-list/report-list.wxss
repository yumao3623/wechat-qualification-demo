.guest-state { padding-top: 50rpx; text-align: center; }
.empty-illustration { width: 120rpx; height: 120rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #e4f1f1; color: #0c6b68; font-size: 70rpx; line-height: 120rpx; }
.login-button { margin-top: 34rpx; }
.start-button, .empty-start { margin-top: 18rpx; }
.login-error { margin-top: 24rpx; text-align: left; }
.report-card { border-left: 8rpx solid #78909a; }
.status-ready { border-left-color: #24877d; }
.status-processing, .status-pending { border-left-color: #337aa1; }
.status-failed { border-left-color: #a34d3e; }
.company-name { flex: 1; color: #173d51; font-size: 30rpx; font-weight: 680; }
.status-pill { padding: 6rpx 13rpx; border-radius: 999rpx; background: #edf3f5; color: #345669; font-size: 22rpx; }
.meta { margin-top: 12rpx; color: #7a8992; font-size: 23rpx; }
.summary-list { margin-top: 18rpx; }
.summary-row { display: grid; grid-template-columns: 150rpx 1fr; gap: 12rpx; padding: 10rpx 0; color: #4b6572; font-size: 23rpx; }
.summary-row text:first-child { color: #0c6b68; font-weight: 650; }
.failed-text { margin-top: 16rpx; color: #9b4438; }
.progress-text { margin-top: 16rpx; }
.open-text { margin-top: 20rpx; color: #0c6b68; font-size: 25rpx; font-weight: 650; }
